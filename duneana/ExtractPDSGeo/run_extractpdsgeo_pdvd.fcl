#include "services_dune.fcl"
#include "extractPDSGeoConfig.fcl"

process_name: ExtractPDSGeoOutput

source:
{
    module_type: EmptyEvent
    maxEvents: 1
}

services:
{
    @table::protodunevd_reco_services
}


physics:
{
    analyzers:
    {
        exgeo: @local::extract_pds_geo
    }

    ana:         [ exgeo ]
    end_paths:     [ ana ]
}

